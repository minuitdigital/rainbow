<?xml version="1.0"?>
<!-- Copié dans ~/.config/labwc/ avec autostart (labwc -m le fusionne au rc.xml du système). -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <keyboard>
    <!-- ALLUMAGE sur – (overlay gpio-shutdown, GPIO 3) : arrêt direct, sans le menu de pishutdown. -->
    <keybind key="XF86PowerOff">
      <action name="Execute" command="/sbin/shutdown -h now" />
    </keybind>
  </keyboard>
  <windowRules>
    <!-- Pas de souris sur le tableau : le curseur est caché à l'ouverture de Chromium. -->
    <windowRule identifier="chromium*">
      <action name="HideCursor" />
      <action name="WarpCursor" x="-1" y="-1" />
    </windowRule>
  </windowRules>
</openbox_config>
